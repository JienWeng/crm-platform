# TLS-terminating ingress for the Twenty stack. ONE apex-wildcard host block
# covers everything:
#   api.<apex>          -> API   (server routes /healthz, /auth, /graphql, /rest)
#   app.<apex>          -> default-workspace SPA
#   <workspace>.<apex>  -> per-workspace SPA
# All proxy to the all-in-one Twenty server (serves the built-in frontend + API
# on :3000). TLS is a single Cloudflare DNS-01 *wildcard* cert — issuance needs no
# public inbound, so it works VPN-only or public (port-forward) identically.
#
# Requires the caddy-cloudflare image (DNS module) + a Cloudflare token with
# Zone:DNS:Edit on the zone. Both are wired via docker-compose.yml from .env.
#
# ── INTERIM vs INTENDED ───────────────────────────────────────────────────────
# This `reverse_proxy` serves Twenty's BUILT-IN frontend (stock branding) so SSO
# login + workspace creation work without a frontend build. The INTENDED end-state
# serves the Quandatics-REBRANDED static bundle via file_server on the workspace
# hosts (split from the API), which needs a Node-24 build of twenty-front. See
# DEPLOY-NOTES.md ("Rebranded frontend"). Switch back to file_server then.
{$FRONTEND_WILDCARD_DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy server:3000
	encode gzip zstd
}
