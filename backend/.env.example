# ── Backend environment ─────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit the real .env.
#   cp .env.example .env
#
# This .env is the single source of truth for config: docker-compose.yml only
# passes through the vars listed here, and IS_CONFIG_VARIABLES_IN_DB_ENABLED is
# false so the server does NOT read config from its DB admin panel.

# ── Backend image (custom rebranded build per the Quandatics fork) ────────────
# Medium rebrand is a maintained fork patch over the pinned tag, built with
# backend/build-image.sh and pushed to your registry. Point SERVER_IMAGE at it.
# (Falls back to upstream twentycrm/twenty if you have not built yet.)
SERVER_IMAGE=registry.ourco.com/quandatics/twenty
# Pin a specific version/tag (do NOT use `latest`). The static frontend MUST be
# built from this SAME ref, or GraphQL schemas mismatch. Upstream releases:
# https://github.com/twentyhq/twenty/releases
TAG=v2.8.3-quandatics.1

# ── Public URLs (both MUST be https — the static frontend is https-only) ──────
# SERVER_URL = API/server domain (also the Entra callback host).
# FRONTEND_URL = base host the server uses to build per-workspace subdomain URLs
# (e.g. acme.app.ourco.com), combined with DEFAULT_SUBDOMAIN below.
SERVER_URL=https://api.ourco.com
FRONTEND_URL=https://app.ourco.com

# ── TLS / Caddy (DNS-01 via Cloudflare, wildcard *.app.ourco.com) ─────────────
API_DOMAIN=api.ourco.com
# Wildcard host Caddy serves the static frontend on (every workspace subdomain).
# MUST be the wildcard form so one cert + one block covers all workspaces.
FRONTEND_WILDCARD_DOMAIN=*.app.ourco.com
# Cloudflare API token scoped to Zone:DNS:Edit for this zone (used by Caddy for
# the DNS-01 challenge that issues the wildcard *.app cert):
CLOUDFLARE_API_TOKEN=<cloudflare-zone-dns-edit-token>

# ── Multi-workspace (native, subdomain-per-workspace) ─────────────────────────
# Multiple workspaces on one instance, routed by subdomain under *.app.ourco.com.
IS_MULTIWORKSPACE_ENABLED=true
# Lock workspace creation to server admins (no open self-serve workspaces):
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true
# Default landing subdomain; server builds <subdomain>.<FRONTEND_URL host>:
DEFAULT_SUBDOMAIN=app

# ── Microsoft Entra ID (Azure AD) SSO — SSO-only, no passwords ────────────────
# See CONFIGURE.md for the Azure app-registration steps. Use a SINGLE-TENANT app
# (there is NO tenant env var — the app registration scopes login to your org).
# Callback URLs MUST point at the API/server domain (SERVER_URL), centralized —
# there are NO per-workspace redirect URIs.
AUTH_MICROSOFT_ENABLED=true
AUTH_MICROSOFT_CLIENT_ID=<application-client-id>
AUTH_MICROSOFT_CLIENT_SECRET=<client-secret-value>
AUTH_MICROSOFT_CALLBACK_URL=https://api.ourco.com/auth/microsoft/redirect
AUTH_MICROSOFT_APIS_CALLBACK_URL=https://api.ourco.com/auth/microsoft-apis/get-access-token
# Force SSO-only: disable password login. Google is left disabled (unset).
AUTH_PASSWORD_ENABLED=false

# ── Config source ─────────────────────────────────────────────────────────────
# Keep THIS .env authoritative (do not read config from the DB admin panel):
IS_CONFIG_VARIABLES_IN_DB_ENABLED=false

# ── Database ──────────────────────────────────────────────────────────────────
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=<strong-password-no-special-chars>
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Secrets (generate each with: openssl rand -base64 32) ─────────────────────
ENCRYPTION_KEY=<generate: openssl rand -base64 32>
# FALLBACK_ENCRYPTION_KEY: set to the PREVIOUS ENCRYPTION_KEY during a rotation.
FALLBACK_ENCRYPTION_KEY=<generate: openssl rand -base64 32>
# APP_SECRET: legacy; only needed for instances predating ENCRYPTION_KEY.
APP_SECRET=<generate: openssl rand -base64 32>

# ── Proxy ──────────────────────────────────────────────────────────────────────
TRUST_PROXY=1

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_TYPE=local
# To use S3 later:
# STORAGE_TYPE=s3
# STORAGE_S3_REGION=eu-west-3
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# ── Optional: Outlook mail/calendar sync (out of scope for now) ───────────────
# Leave disabled. Enable later by uncommenting these AND the matching lines in
# docker-compose.yml (server + worker). Needs Graph scopes + an M365 licence.
# MESSAGING_PROVIDER_MICROSOFT_ENABLED=true
# CALENDAR_PROVIDER_MICROSOFT_ENABLED=true

# ── Optional: migrations / cron toggles ────────────────────────────────────────
# DISABLE_DB_MIGRATIONS=
# DISABLE_CRON_JOBS_REGISTRATION=
