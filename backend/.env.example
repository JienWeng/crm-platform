# ── Backend environment ─────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit the real .env.
#   cp .env.example .env

# Backend image. Default = official upstream. If you fork and build your own
# (see backend/build-image.sh), set SERVER_IMAGE to your registry path.
SERVER_IMAGE=twentycrm/twenty
# Pin a specific version/tag (do NOT use `latest`). The static frontend MUST be
# built from this SAME ref, or GraphQL schemas mismatch. Upstream releases:
# https://github.com/twentyhq/twenty/releases
TAG=v2.8.3

# ── Public URLs (both MUST be https — the static frontend is https-only) ──────
SERVER_URL=https://api.ourco.com
FRONTEND_URL=https://app.ourco.com

# ── TLS / Caddy (DNS-01 via Cloudflare) ───────────────────────────────────────
API_DOMAIN=api.ourco.com
# Cloudflare API token scoped to Zone:DNS:Edit for this zone:
CLOUDFLARE_API_TOKEN=replace_me

# ── Database ──────────────────────────────────────────────────────────────────
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace_me_strong_password_no_special_chars
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Secrets (generate each with: openssl rand -base64 32) ─────────────────────
ENCRYPTION_KEY=replace_me_random_string
# FALLBACK_ENCRYPTION_KEY=   # set to the previous ENCRYPTION_KEY during a rotation
# APP_SECRET=                # legacy: only for instances predating ENCRYPTION_KEY

# ── Proxy ──────────────────────────────────────────────────────────────────────
TRUST_PROXY=1

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_TYPE=local
# To use S3 later:
# STORAGE_TYPE=s3
# STORAGE_S3_REGION=eu-west-3
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# ── Microsoft Entra ID (Azure AD) SSO ─────────────────────────────────────────
# See CONFIGURE.md for the Azure app-registration steps. There is NO tenant env
# var — restrict to your tenant in Azure (app → "single tenant"). Callback URLs
# MUST point at the API/server domain (this SERVER_URL), not the frontend.
# Also uncomment the matching lines in docker-compose.yml (server + worker).
# AUTH_MICROSOFT_ENABLED=true
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_CALLBACK_URL=https://api.ourco.com/auth/microsoft/redirect
# AUTH_MICROSOFT_APIS_CALLBACK_URL=https://api.ourco.com/auth/microsoft-apis/get-access-token
# For Outlook mail + calendar sync (optional, needs Graph scopes + M365 licence):
# MESSAGING_PROVIDER_MICROSOFT_ENABLED=true
# CALENDAR_PROVIDER_MICROSOFT_ENABLED=true

# ── Auth / signup behavior ─────────────────────────────────────────────────────
# Password login is ON by default (true). Set false to force SSO-only.
# AUTH_PASSWORD_ENABLED=true
# Single workspace (default). New users join by invite or company-domain
# auto-join (Settings → Members) — there is no IS_SIGN_UP_ENABLED in 2.x.
# Set true only if you want multiple independent workspaces on one instance:
# IS_MULTIWORKSPACE_ENABLED=false
# IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true

# ── Config source ──────────────────────────────────────────────────────────────
# 2.x stores config in the DB by default, editable at Settings → Admin Panel →
# Configuration Variables. Set false to make THIS .env the source of truth for
# the vars above (recommended when you manage config via git/compose).
# IS_CONFIG_VARIABLES_IN_DB_ENABLED=false
