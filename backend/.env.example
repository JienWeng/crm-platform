# ── Backend environment ─────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit the real .env.
#   cp .env.example .env

# Backend image. Default = official upstream. If you fork and build your own
# (see backend/build-image.sh), set SERVER_IMAGE to your registry path.
SERVER_IMAGE=twentycrm/twenty
# Pin a specific version/tag (do NOT use `latest`). The static frontend MUST be
# built from this SAME ref, or GraphQL schemas mismatch. Upstream releases:
# https://github.com/twentyhq/twenty/releases
TAG=v2.8.3

# ── Public URLs (both MUST be https — the static frontend is https-only) ──────
SERVER_URL=https://api.ourco.com
FRONTEND_URL=https://app.ourco.com

# ── TLS / Caddy (DNS-01 via Cloudflare) ───────────────────────────────────────
API_DOMAIN=api.ourco.com
# Cloudflare API token scoped to Zone:DNS:Edit for this zone:
CLOUDFLARE_API_TOKEN=replace_me

# ── Database ──────────────────────────────────────────────────────────────────
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace_me_strong_password_no_special_chars
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Secrets (generate each with: openssl rand -base64 32) ─────────────────────
ENCRYPTION_KEY=replace_me_random_string
# FALLBACK_ENCRYPTION_KEY=   # set to the previous ENCRYPTION_KEY during a rotation
# APP_SECRET=                # legacy: only for instances predating ENCRYPTION_KEY

# ── Proxy ──────────────────────────────────────────────────────────────────────
TRUST_PROXY=1

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_TYPE=local
# To use S3 later:
# STORAGE_TYPE=s3
# STORAGE_S3_REGION=eu-west-3
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
